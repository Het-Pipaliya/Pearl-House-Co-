# ---- Public ----
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ---- Admin (REQUIRED for /admin) ----
# Choose a long, unique password. Generate the secret with:  openssl rand -base64 32
ADMIN_PASSWORD=
ADMIN_SESSION_SECRET=

# ---- Database + file storage: Supabase (REQUIRED in production) ----
# Leave blank in local development to use a local JSON file (.data/db.json).
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# ---- Email: Resend (REQUIRED for notifications) ----
# Without these, inquiries are still saved but NO emails are sent (the admin dashboard shows a warning).
RESEND_API_KEY=
BUSINESS_EMAIL=
# Must be an address on a domain verified in Resend. The default only works for testing.
EMAIL_FROM="Pearl House & Co <onboarding@resend.dev>"

# ---- Google sign-in + accounts (optional; needs Supabase above) ----
# Public values (safe in the browser) from Supabase -> Project Settings -> API Keys:
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Comma-separated Google accounts allowed into /admin (no admin password needed):
ADMIN_EMAILS=
# SUPABASE_URL may be left blank (NEXT_PUBLIC_SUPABASE_URL is used); SUPABASE_SERVICE_ROLE_KEY = the *secret* key (server only).
